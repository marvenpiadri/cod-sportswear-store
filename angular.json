{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "store": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "store",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/store",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": { "entry": "src/server.ts" },
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "/assets" }
            ]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "sourceMap": false },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "allowedHosts": true, "hmr": false },
          "configurations": {
            "production": { "buildTarget": "store:build:production" },
            "development": { "buildTarget": "store:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}